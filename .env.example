# Where your OmniRoute gateway is running
OMNIROUTE_BASE_URL=http://localhost:20128

# API key created in the OmniRoute dashboard (kept server-side, never sent to the browser)
OMNIROUTE_API_KEY=

# Port for this website
PORT=3000

# Optional: require a password (browser prompt, any username). Strongly recommended
# if this app is reachable by anyone other than you.
APP_PASSWORD=
